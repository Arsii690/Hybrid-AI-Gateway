						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[double hackerProb = main.edge_Gateway.isAttacking ? 0.80 : 0.10;

if (randomTrue(hackerProb)) {
    // MALICIOUS DNA: These values will be picked up by the 'mapping' in Python
    agent.fwd_iat_min = 192;
    agent.flow_iat_min = 36;
    agent.init_win_bytes = 243;
    agent.fwd_header_len = 328;
    
    // Make them visually distinct in your 2D view (optional)
    agent.p_urgency = 1; 
} else {
    // NORMAL DNA: Safe, random network timings
    agent.fwd_iat_min = uniform(1, 10);
    agent.flow_iat_min = uniform(1, 10);
    agent.init_win_bytes = uniform(1000, 3000);
    agent.fwd_header_len = uniform(500, 2000);
}

// Set basic packet info
agent.p_size = uniform_discr(256, 1024);
if (!main.edge_Gateway.isAttacking) {
    agent.p_urgency = uniform_discr(1, 10);
}]]></Code>
							</Value>
