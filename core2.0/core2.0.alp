			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1778093959815</Id>
					<Name><![CDATA[ask_ai]]></Name>
					<X>10</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p_size]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p_urgency]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[q_size]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fwd_iat_min]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[init_win_bytes]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[flow_iat_min]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[fwd_header_len]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[try {
    java.net.URL url = new java.net.URL("http://127.0.0.1:8000/predict");
    java.net.HttpURLConnection conn = (java.net.HttpURLConnection) url.openConnection();
    conn.setRequestMethod("POST");
    conn.setRequestProperty("Content-Type", "application/json");
    conn.setDoOutput(true);

    // 1. Send the data to the Python AI
    String jsonMessage = "{\"Fwd IAT Min\": " + fwd_iat_min + ", \"Init_Win_bytes_backward\": " + init_win_bytes + ", \"Flow IAT Min\": " + flow_iat_min + ", \"Fwd Header Length\": " + fwd_header_len + ", \"p_size\": " + p_size + ", \"p_urgency\": " + p_urgency + ", \"queue_size\": " + q_size + "}";
    
    try(java.io.OutputStream os = conn.getOutputStream()) {
        byte[] input = jsonMessage.getBytes("utf-8");
        os.write(input, 0, input.length);
    }

    // 2. Listen for the Python AI's answer
    java.util.Scanner scanner = new java.util.Scanner(conn.getInputStream(), "UTF-8");
    String response = scanner.useDelimiter("\\A").hasNext() ? scanner.next() : "";
    scanner.close();

    // 3. Parse the answer (e.g., extracting "99" or "0")
    int colonIndex = response.indexOf(":");
    int braceIndex = response.indexOf("}");
    int decision = Integer.parseInt(response.substring(colonIndex + 1, braceIndex).trim());
    
    // --- 4. UPDATE THE UI MEMORY (Must be after 'decision' is created!) ---
    lastDecision = decision; 
    
    // 5. Tell the physical router where to go
    if (decision == 99) {
        return 3; // Lane 4 (Trash)
    }
    
    return decision; // Lane 0, 1, or 2

} catch (Exception e) {
    traceln("Walkie-Talkie Error: " + e.getMessage());
    return 1; 
}]]></Body>
				</Function>
			</Functions>
